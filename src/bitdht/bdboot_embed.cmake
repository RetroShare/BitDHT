# 3.7 : if(VERSION_GREATER_EQUAL)
# 3.13: math(OUTPUT_FORMAT HEXADECIMAL)
cmake_minimum_required(VERSION 3.13...4.4)

function(inet_aton numbers_and_dots addr_out)
	string(REPLACE "." ";" addr_comps ${numbers_and_dots})
	list(POP_BACK addr_comps addr_last)

	set(${addr_out} ${addr_last})
	set(shift 24)
	foreach(addr_comp ${addr_comps})
		if(NOT addr_comp GREATER_EQUAL "0" OR NOT addr_comp LESS "256")
			message(FATAL_ERROR "address component '${addr_comp}' is out of range")
		elseif(NOT shift GREATER "0")
			message(FATAL_ERROR "too many components in address: ${numbers_and_dots}")
		endif()

		math(EXPR ${addr_out} "${${addr_out}} + (${addr_comp} << ${shift})")
		math(EXPR shift "${shift} - 8")
	endforeach()

	math(EXPR last_valid "${addr_last} >> (${shift} + 8)")
	if(NOT last_valid EQUAL "0")
		message(FATAL_ERROR "address component '${addr_last}' is out of range")
	endif()

	set(${addr_out} ${${addr_out}} PARENT_SCOPE)
endfunction()


set(bdboot_embed.c "")

# header comment
string(APPEND bdboot_embed.c
	"// DO NOT EDIT\n"
	"// This file was automatically generated by ${CMAKE_CURRENT_LIST_FILE} "
		"from ${BDBOOT_SOURCE}.\n"
	"\n"
)

# includes
string(APPEND bdboot_embed.c
	"#include <stddef.h>\n"
	"\n"
	"#if defined(_WIN32) || defined(__MINGW32__)\n"
	"#include <winsock.h>\n"
	"#else\n"
	"#include <netinet/in.h>\n"
	# "#include <sys/socket.h>\n"
	"#endif\n"
	"\n"
)

string(APPEND bdboot_embed.c
	"const struct sockaddr_in bdboot_embed[] = {\n"
)

set(addresses "")
foreach(source_file ${BDBOOT_SOURCE})
	file(READ ${source_file} source_content)
	string(REPLACE "\n" ";" source_addresses ${source_content})
	list(APPEND addresses ${source_addresses})
endforeach()

set(location_count 0)
foreach(location ${addresses})
	if(NOT location MATCHES "^([0-9.]+) ([0-9]+)\$")
		if(NOT location STREQUAL "")
			message(FATAL_ERROR "failed to parse location: '${location}'")
		endif()
		continue()
	endif()

	set(addr_dots ${CMAKE_MATCH_1})
	set(port ${CMAKE_MATCH_2})

	inet_aton(${addr_dots} addr_int)
	math(EXPR addr_hex "${addr_int}" OUTPUT_FORMAT HEXADECIMAL)

	string(APPEND bdboot_embed.c
		"(struct sockaddr_in){"
			".sin_family=AF_INET,"
			".sin_addr=(struct in_addr){.s_addr=${addr_hex}},"
			".sin_port=${port},"
		"},\n"
	)

	math(EXPR location_count "${location_count} + 1")
endforeach()

string(APPEND bdboot_embed.c
	"};\n"
)

string(APPEND bdboot_embed.c
	"const size_t bdboot_embed_count = ${location_count};\n"
)

file(WRITE ${OUTPUT} "${bdboot_embed.c}")
